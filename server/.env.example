# Server Environment Variables
PORT=11000
API_VERSION=2025-01
APP_SECRET_KEY=app_secret_key

# Database Configuration
DEV_DB_HOST=db_host
DEV_DB_NAME=db_name
DEV_DB_PASSWORD=db_password
DEV_DB_USERNAME=db_username

# Shopify Configuration
STORE=store.myshopify.com
ACCESS_TOKEN=shopify_access_token

# Trabucco-fishing Shopify Configuration (separate store, same backend)
TRABUCCO_STORE=trabucco-store.myshopify.com
TRABUCCO_ACCESS_TOKEN=trabucco_shopify_access_token

# Yesme (yes-me-cz) Shopify Configuration (separate store, same backend)
YESME_STORE=yes-me-cz.myshopify.com
YESME_ACCESS_TOKEN=yesme_shopify_access_token
YESME_API_VERSION=2026-07
YESME_STOREFRONT_KEY=yesme_storefront_key
YESME_ORDER_EXPORT_RECIPIENTS=yesme_order_export_recipients
# Optional, defaults to YESME_ORDER_EXPORT_RECIPIENTS
YESME_PACKING_LIST_RECIPIENTS=yesme_packing_list_recipients
YESME_EXPORT_KEY=yesme_export_key
# Yes Mě sender and BCC (sent through the shared MANDRILL_API_KEY below)
YESME_MANDRILL_FROM_EMAIL=yesme_from_email
YESME_MANDRILL_FROM_NAME=yesme_from_name
# Optional
YESME_MANDRILL_BCC_ADDRESS=yesme_bcc_email

# Mandrill Email Configuration
MANDRILL_API_KEY=mandrill_api_key
MANDRILL_MESSAGE_FROM_EMAIL=from_email
MANDRILL_MESSAGE_FROM_NAME=from_name
MANDRILL_MESSAGE_BCC_ADDRESS=bcc_email
MANDRILL_MESSAGE_BCC_ADDRESS_DEV=dev_bcc_email
ORDER_EXPORT_RECIPIENTS=order_export_recipients

# Google Services
GOOGLE_GEOCODING_API_KEY=google_geocoding_api_key

# Shopify Collection IDs
COLLECTION_PROGRAMS_ID=collection_id

# Location Configuration
LOCATIONS_XML_FILE=locations_xml_file_urls

# SharePoint Configuration
TENANT_ID=tenant_id
CLIENT_ID=client_id
CLIENT_SECRET=client_secret
SHAREPOINT_HOSTNAME=sharepoint_hostname
SITE_PATH=site_path
EXCEL_FILE_NAME=excel_file_name
WORKSHEET_NAME=worksheet_name